####### Compile

release/configuredialog.o: configuredialog.cpp configuredialog.h \
		release/ui/ui_configuredialog.h \
		../../../inc/bdaqctrl.h \
		../common/DioPortUI.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/configuredialog.o configuredialog.cpp

release/main.o: main.cpp diinterrupt.h \
		configuredialog.h \
		release/ui/ui_configuredialog.h \
		../../../inc/bdaqctrl.h \
		../common/DioPortUI.h \
		release/ui/ui_diinterrupt.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/main.o main.cpp

release/diinterrupt.o: diinterrupt.cpp diinterrupt.h \
		configuredialog.h \
		release/ui/ui_configuredialog.h \
		../../../inc/bdaqctrl.h \
		../common/DioPortUI.h \
		release/ui/ui_diinterrupt.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/diinterrupt.o diinterrupt.cpp

release/DioPortUI.o: ../common/DioPortUI.cpp ../common/DioPortUI.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/DioPortUI.o ../common/DioPortUI.cpp

release/qrc_diinterrupt.o: release/rcc/qrc_diinterrupt.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/qrc_diinterrupt.o release/rcc/qrc_diinterrupt.cpp

release/moc_configuredialog.o: release/moc/moc_configuredialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/moc_configuredialog.o release/moc/moc_configuredialog.cpp

release/moc_diinterrupt.o: release/moc/moc_diinterrupt.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/moc_diinterrupt.o release/moc/moc_diinterrupt.cpp

release/moc_DioPortUI.o: release/moc/moc_DioPortUI.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/moc_DioPortUI.o release/moc/moc_DioPortUI.cpp

