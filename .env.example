# ==============================================================================
# MDDP IIoT Data Ingestion Suite - Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# ==============================================================================

# ─── TimescaleDB (PostgreSQL 16) ──────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=daq_db
DB_PORT=5432
DB_TABLE=daq_telemetry
DB_RETENTION_DAYS=90
DB_COMPRESSION_INTERVAL="1 hour"

# ─── Mosquitto MQTT Broker ───────────────────────────────────────────────────
MQTT_PORT=1883
MQTT_TOPIC=daq/telemetry
MQTT_QOS=0

# ─── InfluxDB 2.x ─────────────────────────────────────────────────────────────
INFLUX_PORT=8086
INFLUX_USERNAME=admin
INFLUX_PASSWORD=adminpassword123
INFLUX_ORG=mddp
INFLUX_BUCKET=daq_telemetry
INFLUX_TOKEN=mddp-super-secret-auth-token

# ─── DAQ Navi Universal Service ──────────────────────────────────────────────
# Set MOCKUP_MODE=true to run without physical PCI/USB DAQ hardware attached
MOCKUP_MODE=false

# Active destination: postgresql | mqtt | influxdb
DESTINATION=postgresql

# Hardware & Sampling Configuration
DEVICE_ID=pci1716-0
CLOCK_RATE=2000
CHANNEL_COUNT=4

# ─── Web Services & Gateways ─────────────────────────────────────────────────
PORTAL_PORT=8080
PLOTTER_PORT=8084
